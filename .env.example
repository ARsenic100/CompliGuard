# AI-Powered PDF Compliance Scanner - Environment Variables
# =========================================================

# GROQ API Key (required)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
MODEL_NAME=llama-3.1-8b-instant
MODEL_TEMPERATURE=0

# Application Settings
MAX_FILE_SIZE_MB=50
MAX_PAGES=500
LOG_LEVEL=INFO

# Database
DB_PATH=data/compliance_scanner.db

# Report Settings
REPORT_OUTPUT_DIR=data/reports
